# oss-tool 이 읽는 설정 목록. 이 파일을 .env 로 복사한 뒤 값만 바꾼다.
#   Copy-Item .env.example .env
# .env 는 커밋하지 않는다(.gitignore). 이 파일(.env.example)은 커밋한다.
# 우선순위: 기본값(config.py) < .env < 셸 환경변수 < 명령 인자

# Ollama 서버 주소. 4주차부터 실제 호출에 쓴다.
OLLAMA_HOST=http://localhost:11434

# 기본 생성 모델. RTX 4070(12 GB) 기준 교재 검증용 값이며 실제 값은 환경 기준표에서 확정한다.
# GPU 가 없는 PC 는 qwen3:0.6b 로 바꾼다.
OLLAMA_MODEL=qwen3:4b

# Hugging Face 토큰. 5주차 이후 필요할 때만 채운다. 실제 값은 절대 커밋하지 않는다.
HF_TOKEN=
