# 복사해서 .env 로 만든다. .env 는 커밋하지 않는다(.gitignore 대상).
# 실제 토큰·비밀번호는 이 수업 예제에 필요 없다. 아래 값은 모두 공개해도 되는 설정이다.

# Ollama 서버 주소. 스킴 없이 host:port 만 써도 코드가 http:// 를 붙인다.
OLLAMA_HOST=http://localhost:11434

# 기본 생성 모델. Q4_K_M, 내려받는 크기 약 5.2 GB. RTX 4070 기준 교재 검증용 기본값.
# GPU 가 없으면 qwen3:0.6b (약 0.5 GB). 둘 다 생각 모드를 켜고 끌 수 있는 하이브리드 태그다.
# 정확한 모델 ID·양자화는 학기별 환경 기준표에서 확정한다.
OLLAMA_MODEL=qwen3:8b

# HTTP 요청 제한 시간(초). 첫 호출은 모델 로드 시간이 포함되므로 넉넉히 둔다.
OLLAMA_TIMEOUT=180
