# 복사해서 .env 로 쓴다. .env 는 커밋하지 않는다. 토큰·개인정보를 넣지 않는다.
# 모델 ID·양자화·용량은 학기별 환경 기준표에서 확정한다. 아래는 교재 검증용 기본값이다.

# Ollama 서버와 생성 모델 (CPU 대체: qwen3:0.6b)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# Ollama 임베딩 모델 (--backend ollama 일 때)
OLLAMA_EMBED_MODEL=bge-m3

# sentence-transformers 임베딩 모델 (--backend st 일 때)
HF_EMBED_MODEL=intfloat/multilingual-e5-small
# Hugging Face 캐시 위치를 바꿀 때만 설정
# HF_HOME=
# 네트워크 없는 실습실: 캐시에 있는 모델만 사용
# HF_HUB_OFFLINE=1

# 기본 임베딩 백엔드: st 또는 ollama
EMBED_BACKEND=st
