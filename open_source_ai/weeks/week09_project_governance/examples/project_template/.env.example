# 복사해서 .env 로 쓴다. .env 는 커밋하지 않는다(.gitignore 에 있음).
# 모델 ID·주소의 확정값은 학기별 환경 기준표를 따른다. 아래는 교재 검증용 기본값이다.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# GPU 가 없는 PC 는 소형 모델로 바꾼다.
# OLLAMA_MODEL=qwen3:0.6b
OLLAMA_EMBED_MODEL=bge-m3
HF_TEXT_MODEL=Qwen/Qwen2.5-0.5B-Instruct
HF_EMBED_MODEL=intfloat/multilingual-e5-small
# Hugging Face 토큰은 gated 모델을 쓸 때만. 값은 여기(.env)에만 둔다.
HF_TOKEN=
