# 복사해서 .env 로 쓴다. .env 는 커밋하지 않는다.

# GitHub REST API 호출(repo_health.py·issue_plan_push.py)에 쓰는 개인 토큰. 선택 사항.
# 없으면 repo_health.py 는 비인증(시간당 한도 낮음)으로 동작하고, issue_plan_push.py 는 실행되지 않는다.
# 값은 이 파일이 아니라 .env 에만 적는다.
GITHUB_TOKEN=

# 1교시 조사 대상 저장소(쉼표 구분)
SURVEY_REPOS=huggingface/transformers,ollama/ollama

# VRAM 추정 기본 후보(--candidate 를 주지 않았을 때). 확정 모델은 환경 기준표를 따른다.
OLLAMA_MODEL=qwen3:4b
OLLAMA_MODEL_SMALL=qwen3:0.6b
GPU_VRAM_GB=12
