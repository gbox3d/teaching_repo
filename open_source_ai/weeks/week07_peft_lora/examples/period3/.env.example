# 복사해서 .env 로 저장한다. .env 는 커밋하지 않는다(.gitignore 확인).
# 값이 비어 있으면 코드의 기본값을 쓴다. 모델 ID·revision·용량은 학기별 환경 기준표에서 확정한다.

# Transformers 소형 생성 모델(LoRA 실습 기본)
HF_TEXT_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# Hugging Face 캐시 위치를 바꿀 때만 주석을 풀고 경로를 적는다.
# HF_HOME=D:\hf-cache

# 네트워크가 막힌 실습실에서 캐시만 쓰려면 주석을 푼다.
# HF_HUB_OFFLINE=1

# gated 모델을 쓸 때만. 실제 토큰을 이 파일(.env.example)이나 저장소에 적지 않는다.
# HF_TOKEN=
