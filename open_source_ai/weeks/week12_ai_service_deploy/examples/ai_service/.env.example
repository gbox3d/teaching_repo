# 복사해서 .env 로 만들고 값을 채운다. .env 는 커밋하지 않는다(.gitignore 가 막는다).
# 우선순위: 코드 기본값 < .env < 셸 환경변수 < 명령 인자

# --- 모델 서버(Ollama) -----------------------------------------------------
# 앱 서버가 찾아갈 주소. 컨테이너 안에서 실행할 때는 http://host.docker.internal:11434
OLLAMA_HOST=http://localhost:11434
# 기본 생성 모델. CPU 대체는 qwen3:0.6b. 실제 모델 ID·양자화는 환경 기준표에서 확정한다.
OLLAMA_MODEL=qwen3:4b
# 모델 서버 응답 대기 시간(초). 0.5 처럼 짧게 주면 504 를 재현할 수 있다.
OLLAMA_TIMEOUT=60

# --- 앱 서버(FastAPI) ------------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=8000
SERVICE_NAME=osa-ai-service
SYSTEM_PROMPT=너는 오픈소스 AI 응용 수업의 도우미다. 한국어로 짧고 정확하게 답한다.
# 브라우저에서 직접 fetch 하는 출처(origin) 목록. 쉼표로 구분한다.
CORS_ORIGINS=http://localhost:7860,http://127.0.0.1:7860
# 요청 기록(requests.jsonl)·점검 결과를 남길 폴더
LOG_DIR=outputs

# --- UI·점검 스크립트 -------------------------------------------------------
API_BASE_URL=http://localhost:8000
UI_PORT=7860
