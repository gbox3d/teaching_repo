# 복사해서 .env 로 만든다. .env 는 커밋하지 않는다(.gitignore 대상).
# 아래 값은 모두 공개해도 되는 설정이다. 실제 토큰은 이 수업 예제에 필요 없다.

# 2교시 생성 모델. 교재 검증용 기본값. 확정 ID·revision 은 학기별 환경 기준표를 따른다.
HF_TEXT_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# 2교시 감성 분류 모델(소형 다국어, 라벨 positive/neutral/negative). 교재 검증용 기본값.
HF_CLS_MODEL=lxyuan/distilbert-base-multilingual-cased-sentiments-student

# 6·7주차에서 쓸 임베딩 모델. 이번 주에는 precache.py 와 카드 분석에만 쓴다.
HF_EMBED_MODEL=intfloat/multilingual-e5-small

# Hugging Face 캐시 위치. 실습실 공용 캐시를 쓰면 주석을 풀고 안내받은 경로를 적는다.
# 비워 두거나 주석이면 기본 위치(사용자 홈의 .cache\huggingface\hub)를 쓴다.
# HF_HOME=D:\hf-cache

# 사전 캐시가 끝난 뒤 1 로 두면 네트워크 없이 캐시만 쓴다. 캐시에 없는 모델은 즉시 실패한다.
# 2교시 실패 경로 B 에서 1 로 바꿨다가 0 으로 되돌린다.
HF_HUB_OFFLINE=0

# gated 모델 파일을 받을 때만 필요하다. 이번 주 실습 범위 밖이며, 쓰더라도 값은 .env 에만 둔다.
HF_TOKEN=
