# 복사해서 .env로 저장한다: Copy-Item .env.example .env
# 실제 토큰·개인정보는 이 파일에도, .env에도 커밋하지 않는다.

# 기준선(base) 모델. 10주차 LoRA 실습과 같은 모델을 쓴다.
HF_TEXT_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# 10주차 실습에서 저장한 어댑터 폴더(adapter_config.json이 있는 곳).
# 비워 두면 evaluate.py는 기준선만 평가한다.
LORA_ADAPTER_DIR=

# Hugging Face 캐시 위치를 옮길 때만 설정한다.
# HF_HOME=D:\hf-cache

# 네트워크 없이 캐시만 쓰려면 1로 둔다.
# HF_HUB_OFFLINE=1
