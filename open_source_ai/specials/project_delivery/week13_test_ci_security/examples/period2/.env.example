# 13주차 ci_lab 환경변수 예시. 복사해서 .env 로 쓴다. .env 는 커밋하지 않는다.
# 값이 비어 있으면 코드의 기본값이 쓰인다. 모델 ID·양자화는 학기별 환경 기준표에서 확정한다.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# CPU 대체: OLLAMA_MODEL=qwen3:0.6b
OLLAMA_TIMEOUT=60
# 통합 테스트(tests/test_integration.py)를 돌릴 때만 1 로 둔다. 기본 pytest 실행에서는 제외된다.
RUN_INTEGRATION=
