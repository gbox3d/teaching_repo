# ============================================================
# 줄바꿈 정규화
#
# 저장소에는 LF로 저장하고, 체크아웃 시에도 LF를 유지한다.
# 각 PC의 core.autocrlf 설정과 무관하게 동작하므로,
# 다른 PC에서 클론했을 때 전 파일이 수정된 것처럼 보이는 문제가 없다.
# ============================================================

* text=auto eol=lf

# ------------------------------------------------------------
# 바이너리 — 줄바꿈 변환 금지
# ------------------------------------------------------------

# 문서
*.pdf   binary
*.docx  binary
*.pptx  binary

# 이미지
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.svg   text

# 압축
*.zip   binary
*.7z    binary
