{
  "name": "teaching-repo-library",
  "version": "1.0.0",
  "private": true,
  "description": "Build the teaching repository as a searchable static slide library.",
  "type": "module",
  "scripts": {
    "build": "node scripts/render-site.mjs",
    "check": "node scripts/check-site.mjs",
    "test": "npm run check && node --test scripts/deck-fit.test.mjs && npm run test:labs",
    "test:labs": "node --test web_programming/tools/guestbook-api/server.test.mjs web_programming/specials/home_iot_http/examples/simulator/server.test.mjs web_programming/specials/supabase_guestbook/examples/06_http_lab/request.test.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@marp-team/marp-core": "4.4.0"
  }
}
