@baseUrl = {{$dotenv API_BASE_URL}}
@apiKey = {{$dotenv API_PUBLIC_KEY}}
@bookId = {{$dotenv BOOK_ID}}

### 접속 확인: 200, 안내 배열
GET {{baseUrl}}/rest/v1/about
apikey: {{apiKey}}

### 도움말: 200, 메서드·경로 배열
GET {{baseUrl}}/rest/v1/help
apikey: {{apiKey}}

### 자기 목록: 200, 글 배열
GET {{baseUrl}}/rest/v1/guestbook?book_id=eq.{{bookId}}&order=id.desc&limit=50
apikey: {{apiKey}}

### 수정: 200, 변경된 한 행. []이면 태그·ID 확인
# @prompt entryId 자기 GET 목록의 ID
PATCH {{baseUrl}}/rest/v1/guestbook?id=eq.{{entryId}}&book_id=eq.{{bookId}}
apikey: {{apiKey}}
Content-Type: application/json
Prefer: return=representation

{"message":"REST 수정 연습입니다."}

### 같은 ID 재조회: 200, 수정값 또는 삭제 뒤 []
# @prompt entryId 확인할 자기 글 ID
GET {{baseUrl}}/rest/v1/guestbook?id=eq.{{entryId}}&book_id=eq.{{bookId}}
apikey: {{apiKey}}

### 삭제: 204, 본문 없음. 위 같은 ID 조회로 부재 확인
# @prompt entryId 삭제할 자기 글 ID
DELETE {{baseUrl}}/rest/v1/guestbook?id=eq.{{entryId}}&book_id=eq.{{bookId}}
apikey: {{apiKey}}
