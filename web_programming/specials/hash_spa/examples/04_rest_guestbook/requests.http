@baseUrl = {{$dotenv API_BASE_URL}}
@apiKey = {{$dotenv API_PUBLIC_KEY}}
@bookId = {{$dotenv BOOK_ID}}
@messageId = {{$dotenv MESSAGE_ID}}

### 1. 접속 확인: 200과 소개 배열
GET {{baseUrl}}/rest/v1/about
apikey: {{apiKey}}

### 2. API 도움말: 200과 단계 배열
GET {{baseUrl}}/rest/v1/help?order=step.asc
apikey: {{apiKey}}

### 3. 목록 조회: 200과 글 배열
GET {{baseUrl}}/rest/v1/guestbook?book_id=eq.{{bookId}}&select=id,name,message,created_at&order=id.desc&limit=50
apikey: {{apiKey}}

### 4. 글 저장: 201과 생성 ID, ID를 .env의 MESSAGE_ID에 기록
POST {{baseUrl}}/rest/v1/guestbook
apikey: {{apiKey}}
Content-Type: application/json
Prefer: return=representation

{ "book_id": "{{bookId}}", "name": "SPA 연습", "message": "서버에 저장한 글" }

### 5. 같은 ID 확인: 200과 글 1개
GET {{baseUrl}}/rest/v1/guestbook?id=eq.{{messageId}}&book_id=eq.{{bookId}}
apikey: {{apiKey}}

### 6. 글 수정: 200과 변경 배열, []이면 변경 없음
# @prompt password 편집 키를 입력하세요.
PATCH {{baseUrl}}/rest/v1/guestbook?id=eq.{{messageId}}&book_id=eq.{{bookId}}
apikey: {{apiKey}}
X-Edit-Key: {{password}}
Content-Type: application/json
Prefer: return=representation

{ "message": "SPA 수정 연습" }

### 7. 수정 후 같은 ID 확인: message 비교
GET {{baseUrl}}/rest/v1/guestbook?id=eq.{{messageId}}&book_id=eq.{{bookId}}
apikey: {{apiKey}}

### 8. 글 삭제: 204와 빈 본문
# @prompt password 편집 키를 입력하세요.
DELETE {{baseUrl}}/rest/v1/guestbook?id=eq.{{messageId}}&book_id=eq.{{bookId}}
apikey: {{apiKey}}
X-Edit-Key: {{password}}

### 9. 삭제 후 같은 ID 확인: 200 []
GET {{baseUrl}}/rest/v1/guestbook?id=eq.{{messageId}}&book_id=eq.{{bookId}}
apikey: {{apiKey}}
